# ==============================================================================
# BHALYAM CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend Server URL (default: http://localhost:4000)
VITE_SERVER_URL=http://localhost:4000

# Supabase Auth Configuration (optional in local development)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Older Supabase projects issue an "anon" key; newer ones call it "publishable". Either works:
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Privacy Contact & Grievance Redressal (DPDP Section 13)
# Optional in local development; set in production to an inbox monitored for data requests.
# When unset, the UI honestly explains that the grievance channel is not live yet.
# Must be a valid email containing an '@' symbol.
VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com

# Optional, LOCAL DEVELOPMENT ONLY: auto-unlocks /admin/* in `npm run dev`
# without pasting an operational key into the sign-in prompt by hand.
#
# This is read ONLY when `import.meta.env.DEV` is true — see the guard in
# client/src/lib/operationalApi.ts (`readOperationalKey`) — and a production
# build strips it via dead-code elimination. That guard only protects you if
# this file is never copied verbatim into a real deployment's environment.
#
# SECURITY — this is NOT a secret and must never be set to, or match, the
# server's OPERATIONAL_SECRET (server/.env.example). Every VITE_-prefixed
# variable is compiled into the public JavaScript bundle: anyone who opens
# the built app's source can read this value. If it is ever equal to the
# real operational key, that key is public. Leave the obviously-fake
# placeholder below (or leave it unset) everywhere except your own machine.
VITE_OPERATIONAL_KEY=local-dev-only-not-a-real-secret
