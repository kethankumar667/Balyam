VITE_SERVER_URL=http://localhost:4000

# ── Accounts (Supabase) ─────────────────────────────────────────────────
#
# Both unset is a SUPPORTED state, not a broken one. With no keys the app
# behaves exactly as it did before accounts existed: signing in flips a local
# flag, every screen says so out loud, and `npm run dev` still needs zero
# infrastructure. Set them and sign-in becomes real everywhere at once.
#
# Where to find them: Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://hjsahhpncmfnrldsfxra.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vXeg32Kgo-GKk3oQrQG01A_VS0HB87M
#
# Older projects call that key "anon" instead and show a JWT. Both names are
# read, publishable first, so use whichever your dashboard shows:
#   VITE_SUPABASE_ANON_KEY=
#
# The key is PUBLIC by design — it ships in the JavaScript bundle and
# identifies the project without authorising anything. Row Level Security is
# what protects the data; see supabase/migrations/0001_accounts.sql. Never put
# the service_role key here: that one bypasses RLS entirely.
#
# Full setup, including the Google provider and the redirect URLs it needs:
# docs/runbooks/supabase.md
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ─── Crash reporting (Sentry) ───────────────────────────────────────────────
#
# Unset (the default) keeps the client bundle entirely free of the Sentry SDK
# — the import is dynamic and only happens on the first recorded error, so an
# unset DSN costs zero bytes. Set it and client-side crashes (error boundary
# catches, unhandled rejections, socket failures) are forwarded remotely.
# Like the Supabase key, the DSN is public by design — it identifies the
# project, it authorises nothing.
# VITE_SENTRY_DSN=
