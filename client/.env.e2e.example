# ==============================================================================
# BHALYAM STAGING SMOKE SUITE — ENVIRONMENT TEMPLATE
# ==============================================================================
#
# Copy to a local, untracked .env.e2e (or export these directly in your shell /
# CI job) before running `npm run test:e2e:staging`. See client/e2e/support/env.ts
# for the exact safety contract these three variables enforce — absent, malformed,
# or accidentally-production values are refused, never silently defaulted.
#
# Never commit a real .env.e2e file. Never put OPERATIONAL_SECRET or any other
# credential in this file — the smoke suite deliberately never needs one (see
# SMOKE-06 in client/e2e/staging-smoke.spec.ts).

# Required. The deployed frontend URL to test against.
E2E_BASE_URL=http://localhost:5173

# Required. The deployed backend URL to test against (health, Socket.IO, operational
# denial checks all go here).
E2E_API_URL=http://localhost:4000

# Required for any non-localhost E2E_BASE_URL / E2E_API_URL. Explicit confirmation
# that this run is intended to reach a real, remote (e.g. staging) deployment —
# there is no default that lets a remote run happen by accident.
# E2E_ALLOW_REMOTE=true
