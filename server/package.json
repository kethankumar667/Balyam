{
  "name": "multiplayer-games-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "an-array-of-english-words": "^2.0.0",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "popular-english-words": "^1.0.2",
    "socket.io": "^4.7.5",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.4.5"
  },
  "//": "typescript, tsc-alias and the @types/* packages are build-time tools but live in `dependencies` on purpose: the host compiles the server after installing, and a host that installs without devDependencies (NODE_ENV=production, npm omit=dev) would otherwise fail the build. Only test and dev-server tooling stays in devDependencies.",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.7.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
