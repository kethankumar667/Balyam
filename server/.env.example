PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Signing key for seat tokens (server/src/lib/seatToken.ts), and later for
# login sessions.
#
# Leave it unset locally: the server generates a random one per process, which
# is correct while rooms live only in memory — a restart destroys the rooms the
# tokens referred to, so the tokens dying with them costs nothing.
#
# The same is true on Render's free tier today: an idle spin-down or a deploy
# takes the rooms and the key together.
#
# It becomes MANDATORY once accounts land. A login session has to outlive a
# restart, and on the free tier restarts are routine — every idle spin-down and
# every deploy. With an ephemeral key, each one would silently sign out every
# logged-in player. Set it as a Render environment variable then, once, and
# never rotate it casually: rotating invalidates every live session.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Postgres connection string for durable accounts and profiles.
#
# Unset is a supported state, not a broken one: the persistence layer no-ops
# and the app runs exactly as it does today, which is what keeps `npm run dev`
# free of infrastructure.
#
# Prefer a hosted instance over Render's free Postgres, which is DELETED after
# 30 days.
# DATABASE_URL=
