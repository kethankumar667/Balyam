# ==============================================================================
# BHALYAM SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

PORT=4000
NODE_ENV=development

# Client Origin allowlist for CORS and Socket.IO long-polling fallback.
# Comma-separated list of allowed origins. In production, set to the deployed
# client URL(s) without trailing slashes.
# Default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Operational Key for the Administrative API & Operations Console (/admin/*).
# Required in production — requireOperationalAuth refuses every request
# without it, and assertOperationalAuthConfigured refuses to even boot a
# production process that has neither this nor ADMIN_USER_IDS set. Must be
# at least 16 characters.
#
# SECURITY — generate a fresh random value per deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Never reuse the placeholder below as a real secret, and never set the
# client's VITE_OPERATIONAL_KEY (client/.env.example) to this same value —
# that variable is compiled into the public JavaScript bundle and would
# publish this secret to every visitor. The two are deliberately unrelated:
# this is the real credential the server checks; the client one is a
# DEV-only convenience that must never carry a real secret.
OPERATIONAL_SECRET=replace-with-a-freshly-generated-random-secret

# Optional: Comma-separated list of Supabase User UUIDs who have admin access.
# When signed in with one of these accounts, /admin routes unlock automatically.
# Example: ADMIN_USER_IDS=e5b8e21a-4d72-4d2a-b9c1-7f8d9a2e3b4c
ADMIN_USER_IDS=

# Session Secret for Guest & Seat Authentication Tokens
# Required in production. Signs guest identity tokens and in-room HMAC seatTokens.
# Without this, the server generates a process-local ephemeral key: every restart
# or redeployment invalidates active guest tokens and orphans their progression.
# Generate a fresh 32+ byte random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-stable-random-session-secret

# Voucher HMAC Secret for Economy V1
# Required in production for durable Economy V1 voucher persistence.
# Raw bearer codes are hashed with HMAC-SHA256 using this key before database storage.
# Must remain STABLE across deployments and restarts.
# WARNING: Rotating this secret will make all outstanding, unredeemed vouchers
# unverifiable (their stored hashes will not match).
# Generate a fresh 32+ byte random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_HMAC_SECRET=replace-with-a-stable-random-voucher-secret

# Supabase Persistence & Auth Configuration
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are REQUIRED in production — without
# them, progression and Economy V1 stores refuse to start (initialiseProgressionStore /
# initialiseEconomyStore). Left ACTIVE below, not commented out, so a deployment
# cannot mistake "documented as an example" for "actually configured": replace both
# placeholders with the real project values outside Git before deploying.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
#
# Optional. Only needed if session verification uses the Supabase JWT secret or
# Auth API path instead of (or in addition to) the service-role key above — see
# verificationMode() in server/src/lib/supabaseAuth.ts for exactly which
# combination is active. Uncomment whichever your deployment actually uses.
# SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional: WebRTC ICE / TURN Relay Configuration
# If unset, the server falls back to STUN-only mode (Google STUN pool), which works
# for most networks but fails for players behind symmetric NATs (cellular/firewalled Wi-Fi).
# When configuring TURN, choose ONE credential mode (ephemeral mode takes precedence if both set):
#
# Mode 1: Ephemeral credentials (Coturn REST API scheme, preferred)
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=your-coturn-static-auth-secret
# TURN_TTL_SECONDS=3600
#
# Mode 2: Static credentials
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=your-static-turn-username
# TURN_PASSWORD=your-static-turn-password
#
# Optional custom STUN pool (comma-separated):
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
