# Generated placeholder audio (client/scripts/gen-placeholder-audio.mjs).
# ~7 MB of synthesized stand-ins, rebuilt by `npm run audio:placeholders`
# and automatically on `npm run dev`. Real recordings are committed as .mp3
# at the same paths and take precedence over these.
client/public/audio/themes/**/*.wav

# AI agent harness & local state
.agents/

# Generated test reports
reports/
client/reports/

# Saved rooms the server writes while it runs (FileRoomSnapshotRepository). Player ids and names; the server
# deletes and recreates them on its own, so they were never meant to be committed.
server/.room_snapshots/
server/.test_room_snapshots/
